# ==============================================================================
# SKYSWIFT FLIGHTS - BACKEND ENVIRONMENT & CREDENTIALS CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials.
#
# QUICK START:
# 1. Set MONGODB_URI (your MongoDB connection string)
# 2. Set EMAIL_HOST, EMAIL_USER, and EMAIL_PASS (for sending booking & contact emails)
# 3. Set DUFFEL_ACCESS_TOKEN or AMADEUS_CLIENT_ID/SECRET (for flight search & bookings)
# 4. Set NEXTAUTH_SECRET (any random 32+ character string)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BRANDING & DOMAIN CONFIGURATION (US Market)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="SkySwift"
NEXT_PUBLIC_BRAND_NAME="SkySwift Flights"
NEXT_PUBLIC_SITE_URL="https://skyswiftflights.com"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="skyswift_super_secret_jwt_key_replace_this_with_random_string_32_chars"

# Customer Support contact details
NEXT_PUBLIC_COMPANY_PHONE="+1 877 371 7356"
NEXT_PUBLIC_SUPPORT_EMAIL="support@skyswiftflights.com"
SUPPORT_EMAIL="support@skyswiftflights.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/skyswift?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/skyswift?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://username:password@cluster0.mongodb.net/skyswift?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 3. BACKEND EMAIL & SMTP CONFIGURATION (Nodemailer)
# ------------------------------------------------------------------------------
# Choose ONE of the providers below and paste the credentials:
#
# OPTION A: Gmail SMTP (Easiest & Free)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Use your full gmail address as EMAIL_USER, and the 16-character app password as EMAIL_PASS
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="SkySwift Flights <your-email@gmail.com>"

# OPTION B: Hostinger / Custom Domain Webmail
# EMAIL_HOST="smtp.hostinger.com"
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER="support@skyswiftflights.com"
# EMAIL_PASS="YourEmailPasswordHere!"
# EMAIL_FROM="SkySwift Flights <support@skyswiftflights.com>"

# OPTION C: SendGrid (Transactional email service)
# EMAIL_HOST="smtp.sendgrid.net"
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER="apikey"
# EMAIL_PASS="SG.your_actual_sendgrid_api_key_here"
# EMAIL_FROM="SkySwift Flights <support@skyswiftflights.com>"

# OPTION D: Resend SMTP
# EMAIL_HOST="smtp.resend.com"
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER="resend"
# EMAIL_PASS="re_your_resend_api_key_here"
# EMAIL_FROM="SkySwift Flights <onboarding@resend.dev>"

# Where internal admin alerts, booking requests, and leads should be emailed:
EMAIL_BOOKINGS_TO="bookings@skyswiftflights.com,owner@skyswiftflights.com"
EMAIL_OWNER="owner@skyswiftflights.com"

# Set to "true" to disable outbound booking emails during testing:
DISABLE_BOOKING_EMAILS="false"

# ------------------------------------------------------------------------------
# 4. FLIGHT SEARCH & BOOKING APIS
# ------------------------------------------------------------------------------
# Duffel API (Primary live flight search & ticketing engine - get from duffel.com)
# Test token format: duffel_test_... / Live token format: duffel_live_...
DUFFEL_ACCESS_TOKEN="duffel_test_your_duffel_access_token_here"
DUFFEL_API_KEY="duffel_test_your_duffel_access_token_here"

# Amadeus API (Alternative GDS provider - get from developers.amadeus.com)
AMADEUS_CLIENT_ID="your_amadeus_client_id_here"
AMADEUS_CLIENT_SECRET="your_amadeus_client_secret_here"

# ------------------------------------------------------------------------------
# 5. CACHING & PERFORMANCE (Upstash Redis - Optional)
# ------------------------------------------------------------------------------
# Sign up at upstash.com to get instant free REST Redis for flight response caching:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 6. CRM & SPREADSHEET SYNC (Google Sheets - Optional)
# ------------------------------------------------------------------------------
# Export bookings automatically to a Google Sheet:
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 7. TELEPHONY & WHATSAPP (Twilio - Optional)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
WHATSAPP_SENDER_NUMBER=""

# ------------------------------------------------------------------------------
# 8. SCRAPING PROXIES (Oxylabs / SerpApi - Optional)
# ------------------------------------------------------------------------------
OXYLABS_USERNAME=""
OXYLABS_PASSWORD=""
SERPAPI_KEY=""

# ------------------------------------------------------------------------------
# 9. SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

